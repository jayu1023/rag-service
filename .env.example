# ---- embeddings ----
EMBED_PROVIDER=local                 # local | openai
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# ---- vector store ----
VECTOR_BACKEND=qdrant                # qdrant | pgvector
QDRANT_PATH=./data/qdrant            # embedded mode; ignored when QDRANT_URL is set
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
POSTGRES_DSN=postgresql://rag:rag@localhost:5432/rag

# ---- chunking ----
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ---- retrieval ----
TOP_K=5
CANDIDATE_K=30
HYBRID_ALPHA=0.6                     # weight on dense vs bm25 in RRF-free blend
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- answering ----
OPENAI_API_KEY=
ANSWER_MODEL=gpt-4o-mini
